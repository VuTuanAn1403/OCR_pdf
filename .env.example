# ==============================================================================
# OCR Keyword Counter & LLM Verification Configuration
# ==============================================================================

# LLM Provider: 'auto', 'gemini', 'openai', 'ollama', or 'heuristic'
LLM_PROVIDER=auto

# Google Gemini API Configuration (Recommended - fast & free tier available)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI or OpenAI-Compatible API Configuration (DeepSeek, Groq, vLLM, Ollama)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1   # For local Ollama

# Model selection
# LLM_MODEL=gemini-1.5-flash
# LLM_MODEL=gpt-4o-mini
